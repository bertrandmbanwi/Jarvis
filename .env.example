# ============================================================
# JARVIS Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Model provider: openai (default), anthropic, or local (Ollama / MLX / LM Studio)
# LLM_PROVIDER=openai

# Fully offline: local models only (tools on Ollama/MLX, quick replies on Apple's on-device model)
# OFFLINE_MODE=false
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3:8b
# LOCAL_FAST_MODEL=apple

# OpenAI API key (default provider). Get one at https://platform.openai.com/api-keys
# Keys saved through the Settings panel go to macOS Keychain instead of this file.
OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI tier models and reasoning effort (defaults shown)
# OPENAI_FAST_MODEL=gpt-6-luna
# OPENAI_BRAIN_MODEL=gpt-6.1-sol
# OPENAI_DEEP_MODEL=gpt-6.1-sol        # gpt-6-astra for the flagship (5x the price)
# OPENAI_FAST_EFFORT=low
# OPENAI_BRAIN_EFFORT=medium
# OPENAI_DEEP_EFFORT=high

# Guaranteed schema-valid tool arguments (strict function calling). Off until you've tried it live.
# OPENAI_STRICT_TOOLS=false
# Run scheduled workflow prompts through the Batch API: half price, no tools, results in minutes to hours
# BATCH_FOR_BACKGROUND=false

# Optional: Anthropic instead of OpenAI (set LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# CLAUDE_FAST_MODEL=claude-haiku-4-5
# CLAUDE_BRAIN_MODEL=claude-sonnet-5
# CLAUDE_DEEP_MODEL=claude-opus-5

# Default tier for general chat: fast, brain, or deep
# CLAUDE_DEFAULT_TIER=brain

# Prefer the cloud provider over Ollama when both are available
# PREFER_CLAUDE=true
# Seconds to use Ollama after a cloud failure before retrying the cloud
# CLOUD_RETRY_COOLDOWN_S=60

# Coding agent for development tasks: auto, codex (OpenAI Codex CLI), or claude (Claude Code)
# JARVIS_CODING_AGENT=auto

# Telegram channel: bot token from @BotFather and your numeric user id(s)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_USER_IDS=123456789

# iMessage channel: handles allowed to talk to JARVIS (first = owner). Needs Full Disk Access.
# IMESSAGE_ALLOWED_HANDLES=+15551234567,you@icloud.com

# JARVIS as an MCP server: extra tools to share beyond public-data ones
# JARVIS_MCP_TOOLS=read_file,get_upcoming_events
# MCP servers JARVIS uses are configured in ~/.jarvis/mcp.json

# Cost alert thresholds (USD)
# COST_DAILY_ALERT=2.00
# COST_MONTHLY_ALERT=60.00

# Ollama fallback (used when the cloud API is unreachable)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Voice settings
# Silero voice activity detection (bundled with faster-whisper)
# VAD_ENABLED=true
# VAD_THRESHOLD=0.5
# Interrupt JARVIS by talking over it (use headphones: the local mic has no echo cancellation)
# BARGE_IN_ENABLED=false
# Cloud voice mode ("Live" button): OpenAI GPT-Live, $0.05/min plus delegated work
# OPENAI_LIVE_VOICE=marin
# Send audio to OpenAI when local speech-to-text is unavailable or hears nothing
# STT_CLOUD_FALLBACK=false
# WHISPER_MODEL=base.en
# TTS_ENGINE=kokoro
# TTS_VOICE=af_heart

# Authentication
# PIN auth is enabled by default for remote access. Localhost still opens directly.
# JARVIS_PIN_AUTH_ENABLED=true
# Cloudflare Tunnel is opt-in. When enabled, remote access requires a PIN.
# JARVIS_ENABLE_TUNNEL=false
# Browser origins allowed to call the API besides localhost (comma-separated),
# e.g. when opening the UI from another device on your LAN. Requests from any
# other website are rejected, even though they reach JARVIS from 127.0.0.1.
# JARVIS_ALLOWED_ORIGINS=http://192.168.1.20:3000
# Optionally pin the Chrome extension so only your install can connect.
# JARVIS_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop
# Require the PIN even for local connections. Set this if you expose JARVIS
# through a raw TCP forwarder (ssh -R, ngrok tcp), whose visitors look local.
# JARVIS_DISABLE_LOCAL_BYPASS=false
# Set a custom PIN for remote access when PIN auth is enabled (4-8 digits).
# If not set, JARVIS auto-generates a fresh random 6-digit PIN every launch.
# JARVIS_PIN=1234
# Set to false only if you intentionally want to reuse the saved generated PIN.
# JARVIS_REGEN_PIN=false
# High-risk tools require explicit confirmation by default.
# Set to audit for trusted local development only.
# JARVIS_TOOL_PERMISSION_MODE=enforce
# In enforce mode, a confirmation supplied by the model is NOT trusted (a
# prompt-injected model could set it), so high-risk tools stay blocked until
# confirmed by the app/voice loop. Set this to true to restore the older
# behavior where the model's confirmation counts. Leave unset to stay secure.
# JARVIS_TRUST_MODEL_CONFIRMATION=true

# Server ports
# API_PORT=8741
# UI_PORT=3741
# Use production for release-like startup, or dev while changing the UI.
# JARVIS_UI_MODE=production

# Logging
# LOG_LEVEL=INFO
